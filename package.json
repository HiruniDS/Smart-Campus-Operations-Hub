{
  "name": "cli-auth-root",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "mvn -f backend/pom.xml spring-boot:run",
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "build": "npm run build --workspace=frontend && mvn -f backend/pom.xml clean package",
    "install:all": "npm install && npm install --workspace=frontend"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
